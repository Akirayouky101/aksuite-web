# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Encryption Key (generate a random string)
NEXT_PUBLIC_ENCRYPTION_KEY=change-this-to-a-random-secure-key

# Server-only configuration (never use NEXT_PUBLIC_ for these secrets)
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://aksuite.app
CRON_SECRET=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:your-email@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64-encoded 32-byte random key; keep the same key to decrypt saved tokens
GOOGLE_TOKEN_ENCRYPTION_KEY=
